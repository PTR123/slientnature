# 前端环境变量配置(Vercel)
# 在Vercel Dashboard中配置以下环境变量

# API地址 - 后端部署完成后修改为实际地址
# 选项1: 使用域名(推荐)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# 选项2: 使用Tailscale IP(开发测试)
# NEXT_PUBLIC_API_URL=http://100.101.102.103:3001

# 选项3: 使用Cloudflare Tunnel域名
# NEXT_PUBLIC_API_URL=https://api-tunnel.yourdomain.com

# 注意:
# 1. 在Vercel Dashboard > Settings > Environment Variables中添加
# 2. 添加变量名: NEXT_PUBLIC_API_URL
# 3. 添加对应的值
# 4. 需要在Production、Preview、Development三个环境都添加