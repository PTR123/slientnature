<!--pages/register/register.wxml-->
<view class="container register-container">
  <view class="register-header">
    <view class="register-title">创建账号</view>
    <view class="register-subtitle">加入 PetKeeper 大家庭</view>
  </view>

  <view class="register-form">
    <!-- 注册方式切换 -->
    <view class="register-tabs">
      <view class="register-tab {{registerType === 'email' ? 'active' : ''}}" bindtap="switchRegisterType" data-type="email">邮箱注册</view>
      <view class="register-tab {{registerType === 'phone' ? 'active' : ''}}" bindtap="switchRegisterType" data-type="phone">手机号注册</view>
    </view>

    <!-- 邮箱注册 -->
    <view wx:if="{{registerType === 'email'}}">
      <view class="form-item">
        <view class="form-label">邮箱 <text class="required">*</text></view>
        <input
          class="input"
          type="text"
          placeholder="请输入邮箱"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">用户名 <text class="required">*</text></view>
        <input
          class="input"
          type="text"
          placeholder="3-20个字符"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">密码 <text class="required">*</text></view>
        <input
          class="input"
          type="password"
          placeholder="至少6个字符"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">确认密码 <text class="required">*</text></view>
        <input
          class="input"
          type="password"
          placeholder="再次输入密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>
    </view>

    <!-- 手机号注册 -->
    <view wx:if="{{registerType === 'phone'}}">
      <view class="form-item">
        <view class="form-label">手机号 <text class="required">*</text></view>
        <input
          class="input"
          type="number"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>

      <view class="form-item">
        <view class="form-label">验证码 <text class="required">*</text></view>
        <view class="code-input-group">
          <input
            class="input code-input"
            type="number"
            placeholder="请输入验证码"
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
          <button
            class="btn-code"
            disabled="{{countdown > 0}}"
            bindtap="sendCode"
          >
            {{countdown > 0 ? countdown + 's' : '发送验证码'}}
          </button>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">用户名 <text class="required">*</text></view>
        <input
          class="input"
          type="text"
          placeholder="3-20个字符"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">密码 <text class="required">*</text></view>
        <input
          class="input"
          type="password"
          placeholder="至少6个字符"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">确认密码 <text class="required">*</text></view>
        <input
          class="input"
          type="password"
          placeholder="再次输入密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>
    </view>

    <button
      class="btn-primary register-btn"
      loading="{{loading}}"
      bindtap="onRegister"
    >
      注册
    </button>

    <view class="register-footer">
      <text>已有账号？</text>
      <text class="link" bindtap="goToLogin">立即登录</text>
    </view>
  </view>
</view>