<!--pages/login/login.wxml-->
<view class="container login-container">
  <view class="login-header">
    <image class="login-logo" src="/images/logo.png" mode="aspectFit"></image>
    <view class="login-title">欢迎回来</view>
    <view class="login-subtitle">登录您的 PetKeeper 账号</view>
  </view>

  <view class="login-form">
    <!-- 登录方式切换 -->
    <view class="login-tabs">
      <view class="login-tab {{loginType === 'email' ? 'active' : ''}}" bindtap="switchLoginType" data-type="email">邮箱登录</view>
      <view class="login-tab {{loginType === 'phone' ? 'active' : ''}}" bindtap="switchLoginType" data-type="phone">手机号登录</view>
    </view>

    <!-- 邮箱登录 -->
    <view wx:if="{{loginType === 'email'}}">
      <view class="form-item">
        <view class="form-label">邮箱</view>
        <input
          class="input"
          type="text"
          placeholder="请输入邮箱"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">密码</view>
        <input
          class="input"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <button
        class="btn-primary login-btn"
        loading="{{loading}}"
        bindtap="onLogin"
      >
        登录
      </button>
    </view>

    <!-- 手机号登录 -->
    <view wx:if="{{loginType === 'phone'}}">
      <view class="form-item">
        <view class="form-label">手机号</view>
        <input
          class="input"
          type="number"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>

      <view class="form-item">
        <view class="form-label">验证码</view>
        <view class="code-input-group">
          <input
            class="input code-input"
            type="number"
            placeholder="请输入验证码"
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
          <button
            class="btn-code"
            disabled="{{countdown > 0}}"
            bindtap="sendCode"
          >
            {{countdown > 0 ? countdown + 's' : '发送验证码'}}
          </button>
        </view>
      </view>

      <button
        class="btn-primary login-btn"
        loading="{{loading}}"
        bindtap="onPhoneLogin"
      >
        登录
      </button>
    </view>

    <!-- 分割线 -->
    <view class="divider-wrapper">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 微信一键登录 -->
    <button
      class="btn-wechat"
      open-type="getPhoneNumber"
      bindgetphonenumber="onWechatLogin"
    >
      <text class="wechat-icon">📱</text>
      <text>微信手机号一键登录</text>
    </button>

    <view class="login-footer">
      <text>还没有账号？</text>
      <text class="link" bindtap="goToRegister">立即注册</text>
    </view>
  </view>
</view>