/* pages/login/login.wxss */

.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #666;
}

.login-form {
  width: 100%;
}

/* 登录方式切换 */
.login-tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-radius: 50rpx;
  background: #f5f5f5;
  padding: 8rpx;
}

.login-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.login-tab.active {
  background: #4a784a;
  color: #fff;
  font-weight: 500;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.login-btn {
  margin-top: 48rpx;
  width: 100%;
}

/* 验证码输入组 */
.code-input-group {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.btn-code {
  background: #f5f5f5;
  color: #4a784a;
  border: none;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.btn-code[disabled] {
  color: #999;
}

/* 分割线 */
.divider-wrapper {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5e5;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* 微信登录按钮 */
.btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx;
  border: none;
  font-size: 32rpx;
}

.wechat-icon {
  margin-right: 12rpx;
  font-size: 40rpx;
}

.login-footer {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #666;
}

.link {
  color: #4a784a;
  font-weight: 500;
}