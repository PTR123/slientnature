/* pages/index/index.wxss */

/* 欢迎区域 */
.welcome-section {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.welcome-content {
  text-align: center;
}

.welcome-logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.welcome-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #4a784a;
  margin-bottom: 20rpx;
}

.welcome-desc {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.welcome-btn {
  width: 500rpx;
}

/* 区块样式 */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 28rpx;
  color: #4a784a;
}

/* 分类网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.category-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 宠物卡片 */
.pet-list {
  display: flex;
  flex-direction: column;
}

.pet-card {
  display: flex;
  align-items: center;
  padding: 20rpx !important;
}

.pet-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.pet-species {
  font-size: 28rpx;
  color: #666;
}

/* 帖子卡片 */
.post-list {
  display: flex;
  flex-direction: column;
}

.post-card {
  padding: 24rpx !important;
}

.post-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.post-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.post-author {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.post-stats {
  display: flex;
  gap: 20rpx;
}

/* 空状态 */
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* 加载状态 */
.loading-state {
  padding: 40rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}