<!--pages/shop/detail/detail.wxml-->
<view class="container detail-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 商品详情 -->
  <view wx:elif="{{product}}">
    <!-- 商品图片 -->
    <swiper class="product-swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{product.images}}" wx:key="index">
        <image
          class="swiper-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onImageTap"
          data-src="{{item}}"
        ></image>
      </swiper-item>
    </swiper>

    <!-- 商品信息 -->
    <view class="product-info card">
      <view class="product-header">
        <view class="product-price">
          <text class="price-current">¥{{product.price}}</text>
          <text wx:if="{{product.originalPrice}}" class="price-original">¥{{product.originalPrice}}</text>
        </view>

        <view class="product-tags">
          <text wx:if="{{product.isHot}}" class="tag hot">热销</text>
          <text wx:if="{{product.isNew}}" class="tag new">新品</text>
          <text wx:if="{{product.isRecommend}}" class="tag recommend">推荐</text>
        </view>
      </view>

      <view class="product-name">{{product.name}}</view>
      <view class="product-desc">{{product.description}}</view>

      <view class="product-meta">
        <text>库存：{{product.stock}} {{product.unit}}</text>
        <text>分类：{{product.category.name}}</text>
      </view>
    </view>

    <!-- 商品详情 -->
    <view class="product-content card">
      <view class="section-title">商品详情</view>
      <rich-text nodes="{{product.content}}"></rich-text>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <view class="quantity-row">
        <text class="quantity-label">数量</text>
        <view class="quantity-controls">
          <button class="quantity-btn" bindtap="onQuantityChange" data-type="minus">-</button>
          <text class="quantity-num">{{quantity}}</text>
          <button class="quantity-btn" bindtap="onQuantityChange" data-type="plus">+</button>
        </view>
      </view>

      <view class="action-buttons">
        <button class="btn-cart" bindtap="addToCart">购物车</button>
        <button class="btn-buy" bindtap="buyNow">立即购买</button>
      </view>
    </view>
  </view>
</view>