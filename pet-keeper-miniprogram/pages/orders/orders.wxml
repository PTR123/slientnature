<!--pages/orders/orders.wxml-->
<view class="container orders-container">
  <!-- 状态筛选 -->
  <view class="status-tabs">
    <view
      class="status-tab {{currentStatus === '' ? 'active' : ''}}"
      bindtap="onStatusChange"
      data-status=""
    >
      全部
    </view>
    <view
      class="status-tab {{currentStatus === 'pending' ? 'active' : ''}}"
      bindtap="onStatusChange"
      data-status="pending"
    >
      待支付
    </view>
    <view
      class="status-tab {{currentStatus === 'paid' ? 'active' : ''}}"
      bindtap="onStatusChange"
      data-status="paid"
    >
      已支付
    </view>
    <view
      class="status-tab {{currentStatus === 'completed' ? 'active' : ''}}"
      bindtap="onStatusChange"
      data-status="completed"
    >
      已完成
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 订单列表 -->
  <view wx:elif="{{orders.length > 0}}" class="order-list">
    <view class="order-card card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-id">订单号：{{item.id}}</text>
        <text class="order-status status-{{item.status}}">
          {{item.status === 'pending' ? '待支付' : item.status === 'paid' ? '已支付' : item.status === 'completed' ? '已完成' : '已取消'}}
        </text>
      </view>

      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="product" wx:key="id">
          <image class="item-image" src="{{product.product.images[0] || '/images/default-product.png'}}" mode="aspectFill"></image>
          <view class="item-info">
            <view class="item-name">{{product.product.name}}</view>
            <view class="item-meta">
              <text>¥{{product.product.price}}</text>
              <text>×{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="order-footer">
        <view class="order-total">
          共 {{item.items.length}} 件商品，合计：
          <text class="total-price">¥{{item.totalAmount}}</text>
        </view>

        <view class="order-actions">
          <button wx:if="{{item.status === 'pending'}}" class="action-btn cancel" catchtap="onCancel" data-id="{{item.id}}">取消订单</button>
          <button wx:if="{{item.status === 'pending'}}" class="action-btn pay" catchtap="onPay" data-id="{{item.id}}">去支付</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text>暂无订单</text>
  </view>
</view>