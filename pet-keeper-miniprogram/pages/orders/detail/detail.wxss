/* pages/orders/detail/detail.wxss */

.detail-container {
  padding-bottom: 80px;
  background: #f5f5f5;
}

/* 状态卡片 */
.status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 16px;
  background: linear-gradient(135deg, #4a784a 0%, #5a885a 100%);
  color: #fff;
  border-radius: 0;
}

.status-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.status-text {
  font-size: 20px;
  font-weight: 500;
}

/* 信息卡片 */
.info-card,
.products-card {
  margin: 12px;
  padding: 16px;
  background: #fff;
  border-radius: 12px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 14px;
  color: #999;
}

.info-value {
  font-size: 14px;
  color: #333;
}

/* 商品列表 */
.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 16px;
  padding-left: 12px;
  border-left: 3px solid #4a784a;
}

.product-item {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.product-image {
  width: 60px;
  height: 60px;
  border-radius: 8px;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 14px;
  color: #333;
  margin-bottom: 8px;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #999;
}

.order-total {
  text-align: right;
  padding-top: 12px;
  border-top: 1px solid #f0f0f0;
  font-size: 14px;
  color: #666;
}

.total-price {
  font-size: 18px;
  font-weight: 600;
  color: #ff6b6b;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid #f0f0f0;
  padding: 12px 16px;
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  z-index: 100;
}

.action-btn {
  padding: 0 32px;
  height: 40px;
  line-height: 40px;
  border-radius: 20px;
  font-size: 16px;
}

.action-btn.cancel {
  background: transparent;
  color: #999;
  border: 1px solid #ddd;
}

.action-btn.pay,
.action-btn.confirm {
  background: #4a784a;
  color: #fff;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60px 0;
  color: #999;
}