/* pages/orders/orders.wxss */

.orders-container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 状态筛选 */
.status-tabs {
  display: flex;
  background: #fff;
  padding: 12px 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.status-tab {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #666;
  padding: 8px 0;
  border-bottom: 2px solid transparent;
}

.status-tab.active {
  color: #4a784a;
  border-bottom-color: #4a784a;
  font-weight: 500;
}

/* 订单列表 */
.order-list {
  padding: 12px;
}

.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 12px;
}

.order-id {
  font-size: 12px;
  color: #999;
}

.order-status {
  font-size: 14px;
  font-weight: 500;
}

.status-pending {
  color: #ff9800;
}

.status-paid {
  color: #4caf50;
}

.status-completed {
  color: #2196f3;
}

.status-cancelled {
  color: #999;
}

/* 订单商品 */
.order-items {
  margin-bottom: 12px;
}

.order-item {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.order-item:last-child {
  margin-bottom: 0;
}

.item-image {
  width: 60px;
  height: 60px;
  border-radius: 8px;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 14px;
  color: #333;
  margin-bottom: 8px;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #999;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  border-top: 1px solid #f0f0f0;
}

.order-total {
  font-size: 14px;
  color: #666;
}

.total-price {
  font-size: 16px;
  font-weight: 600;
  color: #ff6b6b;
}

.order-actions {
  display: flex;
  gap: 12px;
}

.action-btn {
  padding: 6px 16px;
  height: 32px;
  line-height: 32px;
  border-radius: 16px;
  font-size: 14px;
}

.action-btn.cancel {
  background: transparent;
  color: #999;
  border: 1px solid #ddd;
}

.action-btn.pay {
  background: #4a784a;
  color: #fff;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 0;
  color: #999;
  font-size: 14px;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60px 0;
  color: #999;
}