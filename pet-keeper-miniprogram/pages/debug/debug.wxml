<!--pages/debug/debug.wxml-->
<view class="container">
  <view class="section">
    <view class="title">调试信息</view>

    <view class="info-item">
      <text class="label">API地址:</text>
      <text class="value">{{apiBaseUrl}}</text>
    </view>

    <view class="info-item">
      <text class="label">Token:</text>
      <text class="value">{{token || '未登录'}}</text>
    </view>
  </view>

  <view class="section">
    <view class="title">连接测试</view>

    <button bindtap="testHealth" type="primary" loading="{{testing}}">
      测试健康检查
    </button>

    <button bindtap="testLogin" type="default">
      测试登录接口
    </button>

    <button bindtap="clearCache" type="warn">
      清除缓存并重启
    </button>
  </view>

  <view class="section" wx:if="{{result}}">
    <view class="title">测试结果</view>
    <view class="result {{result.success ? 'success' : 'error'}}">
      <text>{{result.message}}</text>
    </view>
    <view class="detail" wx:if="{{result.detail}}">
      <text>{{result.detail}}</text>
    </view>
  </view>

  <view class="section">
    <view class="title">网络请求日志</view>
    <view class="logs">
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        <text>{{item}}</text>
      </view>
    </view>
  </view>
</view>

<view class="footer">
  <text>提示: 请确保已勾选"不校验合法域名"</text>
</view>