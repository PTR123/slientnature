/* pages/pets/pets.wxss */
.container {
  padding: 20rpx;
  background-color: #fefdfb;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.btn-add {
  background-color: #4a784a;
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 50rpx;
  border: none;
}

.btn-add:active {
  background-color: #3d633d;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.pet-list {
  padding-bottom: 20rpx;
}

.pet-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.pet-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  background-color: #f5f5f5;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.pet-species {
  font-size: 28rpx;
  color: #4a784a;
  margin-bottom: 4rpx;
}

.pet-breed {
  font-size: 26rpx;
  color: #999;
}

.pet-gender {
  font-size: 48rpx;
  color: #4a784a;
}

.pet-details {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  min-width: 140rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.pet-notes {
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.notes-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.pet-footer {
  display: flex;
  justify-content: flex-end;
}

.create-time {
  font-size: 24rpx;
  color: #ccc;
}