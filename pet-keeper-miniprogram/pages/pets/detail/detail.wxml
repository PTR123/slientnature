<!--pages/pets/detail/detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 宠物详情 -->
  <view wx:elif="{{pet}}">
    <!-- 头部卡片 -->
    <view class="pet-header card">
      <image
        class="pet-avatar"
        src="{{pet.image || '/images/default-pet.png'}}"
        mode="aspectFill"
        bindtap="previewImage"
      ></image>
      <view class="pet-basic">
        <view class="pet-name">{{pet.name}}</view>
        <view class="pet-species">{{pet.speciesName || pet.species}}</view>
        <view class="pet-breed" wx:if="{{pet.breed}}">{{pet.breed}}</view>
        <view class="pet-gender" wx:if="{{pet.gender}}">
          {{pet.gender === 'male' ? '公' : pet.gender === 'female' ? '母' : '未知'}}
        </view>
      </view>
    </view>

    <!-- 详细信息 -->
    <view class="info-card card">
      <view class="card-title">基本信息</view>
      <view class="info-list">
        <view class="info-item" wx:if="{{pet.birthDate}}">
          <text class="info-label">出生日期</text>
          <text class="info-value">{{pet.birthDate}}</text>
        </view>
        <view class="info-item" wx:if="{{pet.age}}">
          <text class="info-label">年龄</text>
          <text class="info-value">{{pet.age}}</text>
        </view>
        <view class="info-item" wx:if="{{pet.weight}}">
          <text class="info-label">体重</text>
          <text class="info-value">{{pet.weight}}g</text>
        </view>
        <view class="info-item" wx:if="{{pet.color}}">
          <text class="info-label">颜色</text>
          <text class="info-value">{{pet.color}}</text>
        </view>
        <view class="info-item" wx:if="{{pet.createdAt}}">
          <text class="info-label">创建时间</text>
          <text class="info-value">{{pet.createdAt}}</text>
        </view>
      </view>
      <view class="notes-section" wx:if="{{pet.notes}}">
        <view class="info-label">备注</view>
        <view class="notes-content">{{pet.notes}}</view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn-primary" bindtap="showAddRecord">添加记录</button>
      <button class="btn-secondary" bindtap="editPet">编辑信息</button>
      <button class="btn-danger" bindtap="deletePet">删除宠物</button>
    </view>

    <!-- 饲养记录 -->
    <view class="records-section card">
      <view class="card-title">饲养记录</view>
      <view wx:if="{{records.length === 0}}" class="empty-records">
        <text>暂无记录</text>
      </view>
      <view wx:else class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="id">
          <view class="record-header">
            <view class="record-type tag-{{item.type}}">
              {{item.type === 'feed' ? '喂食' :
                item.type === 'clean' ? '清洁' :
                item.type === 'health' ? '健康' :
                item.type === 'weight' ? '称重' : '其他'}}
            </view>
            <view class="record-time">{{item.createdAt}}</view>
          </view>
          <view class="record-content">{{item.content}}</view>
          <view class="record-notes" wx:if="{{item.notes}}">{{item.notes}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加记录弹窗 -->
  <view wx:if="{{showRecordModal}}" class="modal-mask">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">添加记录</text>
        <text class="modal-close" bindtap="hideAddRecord">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">记录类型</text>
          <picker bindchange="onRecordTypeChange" value="{{recordType}}" range-key="label" range="{{recordTypes}}">
            <view class="picker">
              {{recordType === 'feed' ? '喂食' :
                recordType === 'clean' ? '清洁' :
                recordType === 'health' ? '健康' :
                recordType === 'weight' ? '称重' : '其他'}}
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">记录内容</text>
          <textarea
            class="form-textarea"
            placeholder="请输入记录内容"
            value="{{recordContent}}"
            bindinput="onRecordContentInput"
            maxlength="500"
          ></textarea>
        </view>
        <view class="form-item">
          <text class="form-label">备注（可选）</text>
          <textarea
            class="form-textarea"
            placeholder="请输入备注"
            value="{{recordNotes}}"
            bindinput="onRecordNotesInput"
            maxlength="200"
          ></textarea>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="hideAddRecord">取消</button>
        <button class="btn-primary" bindtap="submitRecord">确定</button>
      </view>
    </view>
  </view>
</view>