/* pages/pets/create/create.wxss */
.container {
  padding: 20rpx;
  background-color: #fefdfb;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.form-card {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4444;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #999;
}

.picker-arrow {
  font-size: 28rpx;
  color: #999;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 图片上传 */
.image-upload {
  width: 100%;
  min-height: 300rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.upload-icon {
  font-size: 80rpx;
  color: #ccc;
  line-height: 1;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

/* 按钮组 */
.button-group {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fefdfb;
  border-top: 2rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
}

.button-group button {
  flex: 1;
  margin: 0;
}

.btn-primary {
  background-color: #4a784a;
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 500;
  border: none;
}

.btn-primary:active {
  background-color: #3d633d;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-weight: 500;
  border: none;
}

.btn-secondary:active {
  background-color: #e8e8e8;
}