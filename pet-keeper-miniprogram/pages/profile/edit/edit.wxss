/* pages/profile/edit/edit.wxss */

.edit-container {
  padding: 20px;
  background: #f5f5f5;
}

.edit-form {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
}

/* 头像 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 0 30px;
}

.avatar-image {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  border: 3px solid #4a784a;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.avatar-tip {
  margin-top: 12px;
  font-size: 14px;
  color: #999;
}

/* 表单分区 */
.form-section {
  margin-bottom: 24px;
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 16px;
  padding-left: 12px;
  border-left: 3px solid #4a784a;
}

/* 表单项 */
.form-item {
  margin-bottom: 16px;
}

.form-label {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  font-size: 16px;
  background: #fff;
}

.input:focus {
  border-color: #4a784a;
}

/* 多行文本 */
.textarea {
  width: 100%;
  min-height: 120px;
  padding: 12px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  font-size: 16px;
  background: #fff;
}

.char-count {
  text-align: right;
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  margin-top: 30px;
}