/* pages/profile/settings/settings.wxss */

.settings-container {
  padding: 20px;
  background: #f5f5f5;
}

/* 设置分区 */
.settings-section {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 20px;
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 16px;
  padding-left: 12px;
  border-left: 3px solid #4a784a;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  display: flex;
  align-items: center;
  font-size: 16px;
  color: #333;
}

.setting-icon {
  font-size: 20px;
  margin-right: 12px;
}

/* Picker 项 */
.picker-item {
  cursor: pointer;
}

.picker-value {
  color: #4a784a;
  font-size: 14px;
  height: 40px; /* 设置高度 */
  line-height: 40px; /* view直接包含文字，用line-height居中 */
  padding-right: 8px; /* 右侧留出箭头空间 */
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: 12px;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 20px;
  margin-right: 12px;
}

.menu-label {
  font-size: 16px;
  color: #333;
  flex: 1;
}

.menu-arrow {
  color: #999;
  font-size: 16px;
}