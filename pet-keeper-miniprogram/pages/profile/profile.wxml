<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 未登录状态 -->
  <view wx:elif="{{!userInfo}}" class="not-logged-in">
    <view class="login-prompt">
      <image class="login-logo" src="/images/logo.png" mode="aspectFit"></image>
      <text class="login-title">PetKeeper</text>
      <text class="login-desc">登录后享受完整功能</text>
      <button class="btn-primary login-btn" bindtap="goToLogin">立即登录</button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card card">
      <view class="user-header">
        <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}"></image>
        <view class="user-info">
          <view class="username">{{userInfo.username}}</view>
          <view class="user-id">ID: {{userInfo.id}}</view>
        </view>
        <button class="edit-btn" bindtap="editProfile">编辑</button>
      </view>

      <!-- 统计数据 -->
      <view class="stats-row">
        <view class="stat-item" bindtap="goToPets">
          <view class="stat-num">{{stats.petCount}}</view>
          <view class="stat-label">宠物</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="goToPosts">
          <view class="stat-num">{{stats.postCount}}</view>
          <view class="stat-label">帖子</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <view class="stat-num">{{stats.likeCount}}</view>
          <view class="stat-label">获赞</view>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-card card">
      <view class="menu-item" bindtap="goToPets">
        <text class="menu-icon">🐾</text>
        <text class="menu-label">我的宠物</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToPosts">
        <text class="menu-icon">📝</text>
        <text class="menu-label">我的帖子</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="editProfile">
        <text class="menu-icon">👤</text>
        <text class="menu-label">个人资料</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 更多功能 -->
    <view class="menu-card card">
      <view class="menu-item" bindtap="openSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">设置</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="aboutUs">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-label">关于我们</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="feedback">
        <text class="menu-icon">💬</text>
        <text class="menu-label">反馈建议</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-card card">
      <view class="menu-item" bindtap="clearCache">
        <text class="menu-icon">🗑️</text>
        <text class="menu-label">清除缓存</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item logout" bindtap="logout">
        <text class="menu-icon">🚪</text>
        <text class="menu-label">退出登录</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <!-- 版本信息 -->
    <view class="version-info">
      <text>Version 1.0.0</text>
    </view>
  </view>
</view>