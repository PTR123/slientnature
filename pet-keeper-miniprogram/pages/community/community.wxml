<!--pages/community/community.wxml-->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <view class="sort-tabs">
      <view
        class="sort-tab {{sortBy === 'latest' ? 'active' : ''}}"
        data-sort="latest"
        bindtap="switchSort"
      >
        最新
      </view>
      <view
        class="sort-tab {{sortBy === 'hot' ? 'active' : ''}}"
        data-sort="hot"
        bindtap="switchSort"
      >
        热门
      </view>
    </view>
    <button class="publish-btn" bindtap="goToCreate">发布</button>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{posts.length === 0}}" class="empty-state">
    <text class="empty-icon">📝</text>
    <text class="empty-text">还没有帖子</text>
    <text class="empty-desc">快来发布第一篇帖子吧</text>
    <button class="btn-primary" bindtap="goToCreate">发布帖子</button>
  </view>

  <!-- 帖子列表 -->
  <view wx:else class="post-list">
    <view
      class="post-card card"
      wx:for="{{posts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goToDetail"
    >
      <!-- 作者信息 -->
      <view class="post-header">
        <image class="author-avatar" src="{{item.author.avatar || '/images/default-avatar.png'}}"></image>
        <view class="author-info">
          <view class="author-name">{{item.author.username}}</view>
          <view class="post-time">{{item.createdAt}}</view>
        </view>
      </view>

      <!-- 帖子内容 -->
      <view class="post-content">
        <view class="post-title">{{item.title}}</view>
        <view class="post-text">{{item.content}}</view>

        <!-- 图片列表 -->
        <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
          <image
            class="post-image {{item.images.length === 1 ? 'single' : ''}}"
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="index"
            src="{{img}}"
            mode="aspectFill"
            data-urls="{{item.images}}"
            data-current="{{img}}"
            catchtap="previewImage"
          ></image>
        </view>
      </view>

      <!-- 操作栏 -->
      <view class="post-footer">
        <view class="post-stats">
          <view
            class="stat-item {{item.isLiked ? 'liked' : ''}}"
            data-id="{{item.id}}"
            data-index="{{index}}"
            catchtap="toggleLike"
          >
            <text class="stat-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="stat-num">{{item.likes || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">💬</text>
            <text class="stat-num">{{item.comments || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">👁️</text>
            <text class="stat-num">{{item.views || 0}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore}}" class="load-more">
      <text>加载更多...</text>
    </view>
    <view wx:else class="no-more">
      <text>没有更多了</text>
    </view>
  </view>

  <!-- 悬浮发布按钮 -->
  <view class="fab" bindtap="goToCreate">
    <text class="fab-icon">+</text>
  </view>
</view>