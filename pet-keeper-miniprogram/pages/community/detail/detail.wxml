<!--pages/community/detail/detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 帖子详情 -->
  <view wx:elif="{{post}}">
    <!-- 帖子内容 -->
    <view class="post-card card">
      <!-- 作者信息 -->
      <view class="post-header">
        <image class="author-avatar" src="{{post.author.avatar || '/images/default-avatar.png'}}"></image>
        <view class="author-info">
          <view class="author-name">{{post.author.username}}</view>
          <view class="post-time">{{post.createdAt}}</view>
        </view>
        <view class="post-actions" wx:if="{{post.isOwner}}">
          <text class="action-btn" bindtap="deletePost">删除</text>
        </view>
      </view>

      <!-- 帖子标题 -->
      <view class="post-title">{{post.title}}</view>

      <!-- 帖子正文 -->
      <view class="post-content">{{post.content}}</view>

      <!-- 图片列表 -->
      <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
        <image
          class="post-image"
          wx:for="{{post.images}}"
          wx:key="index"
          src="{{item}}"
          mode="aspectFill"
          data-urls="{{post.images}}"
          data-current="{{item}}"
          bindtap="previewImage"
        ></image>
      </view>

      <!-- 标签 -->
      <view class="post-tags" wx:if="{{post.tags && post.tags.length > 0}}">
        <text class="tag" wx:for="{{post.tags}}" wx:key="index">{{item}}</text>
      </view>

      <!-- 操作栏 -->
      <view class="post-footer">
        <view class="post-stats">
          <view class="stat-item {{post.isLiked ? 'liked' : ''}}" bindtap="toggleLike">
            <text class="stat-icon">{{post.isLiked ? '❤️' : '🤍'}}</text>
            <text class="stat-num">{{post.likes || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">💬</text>
            <text class="stat-num">{{post.comments.length || 0}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">👁️</text>
            <text class="stat-num">{{post.views || 0}}</text>
          </view>
        </view>
        <view class="post-actions">
          <text class="action-btn" bindtap="copyContent">复制</text>
          <button class="share-btn" open-type="share">分享</button>
        </view>
      </view>
    </view>

    <!-- 评论区 -->
    <view class="comments-section card">
      <view class="section-title">评论 ({{comments.length}})</view>

      <!-- 空状态 -->
      <view wx:if="{{comments.length === 0}}" class="empty-comments">
        <text class="empty-icon">💬</text>
        <text class="empty-text">暂无评论</text>
        <text class="empty-desc">快来发表第一条评论吧</text>
      </view>

      <!-- 评论列表 -->
      <view wx:else class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <image class="comment-avatar" src="{{item.author.avatar || '/images/default-avatar.png'}}"></image>
          <view class="comment-content">
            <view class="comment-header">
              <text class="comment-author">{{item.author.username}}</text>
              <text class="comment-time">{{item.createdAt}}</text>
            </view>
            <view class="comment-text">{{item.content}}</view>
            <view class="comment-actions">
              <text
                class="reply-btn"
                data-id="{{item.id}}"
                data-username="{{item.author.username}}"
                catchtap="replyToComment"
              >
                回复
              </text>
            </view>

            <!-- 子回复 -->
            <view class="reply-list" wx:if="{{item.replies && item.replies.length > 0}}">
              <view class="reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
                <text class="reply-author">{{reply.author.username}}</text>
                <text class="reply-text">: {{reply.content}}</text>
                <text class="reply-time">{{reply.createdAt}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 评论输入框 -->
    <view class="comment-input-bar">
      <view class="reply-tip" wx:if="{{replyTo}}">
        <text>回复 @{{replyTo.username}}</text>
        <text class="cancel-reply" bindtap="cancelReply">×</text>
      </view>
      <view class="input-wrapper">
        <input
          class="comment-input"
          placeholder="{{replyTo ? '回复 @' + replyTo.username : '写下你的评论...'}}"
          value="{{commentContent}}"
          bindinput="onCommentInput"
          confirm-type="send"
          bindconfirm="submitComment"
        />
        <button class="submit-btn" bindtap="submitComment">发送</button>
      </view>
    </view>
  </view>
</view>