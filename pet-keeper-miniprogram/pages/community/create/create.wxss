/* pages/community/create/create.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 200rpx;
  background-color: #fefdfb;
  min-height: 100vh;
}

.form-card {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 50rpx;
  position: relative;
  padding-bottom: 10rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4444;
}

.form-input {
  width: 100%;
  height: 80rpx; /* 添加明确高度 */
  padding: 0 24rpx; /* 调整padding */
  line-height: 80rpx; /* 行高与高度一致 */
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  word-wrap: break-word;
  word-break: break-all;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 图片列表 */
.image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
}

.preview-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.add-image {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-image::before {
  content: '';
  display: block;
  padding-top: 100%;
}

.add-image .add-icon,
.add-image .add-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
  line-height: 1;
  margin-top: -20rpx;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 40rpx;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background-color: #e8f5e9;
  border-radius: 30rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #4a784a;
}

.tag-delete {
  font-size: 32rpx;
  color: #999;
  line-height: 1;
}

.tag-input-wrapper {
  display: flex;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.add-tag-btn {
  padding: 16rpx 32rpx;
  background-color: #4a784a;
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fefdfb;
  border-top: 2rpx solid #f0f0f0;
}

.submit-btn {
  width: 100%;
  padding: 28rpx;
  background-color: #4a784a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 50rpx;
  border: none;
}

.submit-btn.disabled {
  background-color: #ccc;
}

.submit-btn::after {
  border: none;
}