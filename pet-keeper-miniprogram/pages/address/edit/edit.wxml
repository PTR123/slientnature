<!--pages/address/edit/edit.wxml-->
<view class="container edit-address-container">
  <view class="form-section">
    <view class="form-item">
      <text class="label">收货人</text>
      <input class="input" placeholder="请输入收货人姓名" value="{{receiverName}}" bindinput="onInput" data-field="receiverName" />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{receiverPhone}}" bindinput="onInput" data-field="receiverPhone" maxlength="11" />
    </view>

    <view class="form-item">
      <text class="label">省份</text>
      <input class="input" placeholder="请输入省份" value="{{province}}" bindinput="onInput" data-field="province" />
    </view>

    <view class="form-item">
      <text class="label">城市</text>
      <input class="input" placeholder="请输入城市" value="{{city}}" bindinput="onInput" data-field="city" />
    </view>

    <view class="form-item">
      <text class="label">区/县</text>
      <input class="input" placeholder="请输入区/县" value="{{district}}" bindinput="onInput" data-field="district" />
    </view>

    <view class="form-item">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="请输入详细地址（街道、楼牌号等）" value="{{detail}}" bindinput="onInput" data-field="detail" />
    </view>

    <view class="form-item switch-item">
      <text class="label">设为默认地址</text>
      <switch checked="{{isDefault}}" bindchange="onSwitch" color="#4a784a" />
    </view>
  </view>

  <view class="btn-container">
    <button class="save-btn" bindtap="onSave" loading="{{saving}}">保存</button>
  </view>
</view>