<!--pages/address/list/list.wxml-->
<view class="container address-list-container">
  <!-- 地址列表 -->
  <view wx:if="{{addresses.length > 0}}" class="address-list">
    <view class="address-item" wx:for="{{addresses}}" wx:key="id">
      <view class="address-content" bindtap="onSelect" data-address="{{item}}">
        <view class="address-header">
          <text class="receiver-name">{{item.receiverName}}</text>
          <text class="receiver-phone">{{item.receiverPhone}}</text>
          <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
        </view>
        <view class="address-detail">
          {{item.province}} {{item.city}} {{item.district}} {{item.detail}}
        </view>
      </view>

      <view class="address-actions">
        <view class="action-btn" catchtap="onEdit" data-id="{{item.id}}">
          <text>编辑</text>
        </view>
        <view class="action-btn" catchtap="onSetDefault" data-id="{{item.id}}" wx:if="{{!item.isDefault}}">
          <text>设为默认</text>
        </view>
        <view class="action-btn delete" catchtap="onDelete" data-id="{{item.id}}">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text>暂无收货地址</text>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn-container">
    <button class="add-btn" bindtap="onAdd">新增收货地址</button>
  </view>
</view>