/* pages/address/list/list.wxss */

.address-list-container {
  padding: 12px;
  padding-bottom: 80px;
  background: #f5f5f5;
  min-height: 100vh;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.address-item {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.address-content {
  padding: 16px;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.receiver-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.receiver-phone {
  font-size: 14px;
  color: #666;
}

.default-tag {
  padding: 2px 8px;
  background: #4a784a;
  color: #fff;
  font-size: 11px;
  border-radius: 4px;
}

.address-detail {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  flex: 1;
  padding: 12px 0;
  text-align: center;
  font-size: 14px;
  color: #666;
  border-right: 1px solid #f0f0f0;
}

.action-btn:last-child {
  border-right: none;
}

.action-btn.delete {
  color: #ff6b6b;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 0;
  color: #999;
  font-size: 14px;
}

/* 添加按钮 */
.add-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 16px;
  background: #fff;
  border-top: 1px solid #f0f0f0;
}

.add-btn {
  width: 100%;
  height: 44px !important;
  background: #4a784a !important;
  color: #fff !important;
  border-radius: 22px !important;
  border: none !important;
  font-size: 15px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.add-btn::after {
  border: none !important;
}