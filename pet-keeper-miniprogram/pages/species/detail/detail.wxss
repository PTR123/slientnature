/* pages/species/detail/detail.wxss */
.container {
  background-color: #fefdfb;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 头部 */
.species-header {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
}

.species-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.species-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 30rpx 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.species-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.species-scientific {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-style: italic;
}

/* 信息卡片 */
.info-card {
  margin: -30rpx 20rpx 20rpx;
  position: relative;
  z-index: 1;
  padding: 30rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 内容卡片 */
.section-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
}

.description-content,
.care-content,
.environment-content,
.precautions-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
}

/* 列表样式 */
.list-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid #4a784a;
}

.list-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.list-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  flex: 1;
}

/* 警告项样式 */
.list-item-warning {
  background-color: #fff3e0;
  border-left-color: #f57c00;
}

/* 图集 */
.image-gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.gallery-image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  object-fit: cover;
}

/* 标签 */
.tags-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  display: inline-block;
  background-color: #e8f5e9;
  color: #4a784a;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}