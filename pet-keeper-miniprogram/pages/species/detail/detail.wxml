<!--pages/species/detail/detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 物种详情 -->
  <view wx:elif="{{species}}">
    <!-- 头部图片 -->
    <view class="species-header">
      <image
        class="species-image"
        src="{{species.image || '/images/default-species.png'}}"
        mode="aspectFill"
        bindtap="previewImage"
        binderror="onImageError"
      ></image>
      <view class="species-overlay">
        <view class="species-name">{{species.name}}</view>
        <view class="species-scientific" wx:if="{{species.scientificName}}">{{species.scientificName}}</view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="info-card card">
      <view class="card-title">基本信息</view>
      <view class="info-list">
        <view class="info-item" wx:if="{{species.category}}">
          <text class="info-label">分类</text>
          <text class="info-value">{{species.categoryName || species.category}}</text>
        </view>
        <view class="info-item" wx:if="{{species.origin}}">
          <text class="info-label">原产地</text>
          <text class="info-value">{{species.origin}}</text>
        </view>
        <view class="info-item" wx:if="{{species.size}}">
          <text class="info-label">体型</text>
          <text class="info-value">{{species.size}}</text>
        </view>
        <view class="info-item" wx:if="{{species.lifespan}}">
          <text class="info-label">寿命</text>
          <text class="info-value">{{species.lifespan}}</text>
        </view>
        <view class="info-item" wx:if="{{species.difficulty}}">
          <text class="info-label">饲养难度</text>
          <text class="info-value">{{species.difficulty}}</text>
        </view>
      </view>
    </view>

    <!-- 详细描述 -->
    <view class="section-card card" wx:if="{{species.description}}">
      <view class="card-title">详细描述</view>
      <view class="description-content">{{species.description}}</view>
    </view>

    <!-- 饲养指南 -->
    <view class="section-card card" wx:if="{{species.careGuide}}">
      <view class="card-title">饲养指南</view>
      <view class="care-content">{{species.careGuide}}</view>
    </view>

    <!-- 环境要求 -->
    <view class="section-card card" wx:if="{{species.environment}}">
      <view class="card-title">环境要求</view>
      <view class="environment-content">{{species.environment}}</view>
    </view>

    <!-- 食物需求 -->
    <view class="section-card card" wx:if="{{species.dietList && species.dietList.length > 0}}">
      <view class="card-title">食物需求</view>
      <view class="list-content">
        <view class="list-item" wx:for="{{species.dietList}}" wx:key="index">
          <view class="list-icon">🍖</view>
          <view class="list-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 底材推荐 -->
    <view class="section-card card" wx:if="{{species.substrateList && species.substrateList.length > 0}}">
      <view class="card-title">底材推荐</view>
      <view class="list-content">
        <view class="list-item" wx:for="{{species.substrateList}}" wx:key="index">
          <view class="list-icon">🌿</view>
          <view class="list-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 装饰建议 -->
    <view class="section-card card" wx:if="{{species.decorList && species.decorList.length > 0}}">
      <view class="card-title">装饰建议</view>
      <view class="list-content">
        <view class="list-item" wx:for="{{species.decorList}}" wx:key="index">
          <view class="list-icon">🏠</view>
          <view class="list-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 生命周期 -->
    <view class="section-card card" wx:if="{{species.lifecycleList && species.lifecycleList.length > 0}}">
      <view class="card-title">生命周期</view>
      <view class="list-content">
        <view class="list-item" wx:for="{{species.lifecycleList}}" wx:key="index">
          <view class="list-icon">🔄</view>
          <view class="list-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 常见疾病 -->
    <view class="section-card card" wx:if="{{species.diseasesList && species.diseasesList.length > 0}}">
      <view class="card-title">常见疾病</view>
      <view class="list-content">
        <view class="list-item list-item-warning" wx:for="{{species.diseasesList}}" wx:key="index">
          <view class="list-icon">⚠️</view>
          <view class="list-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 注意事项 -->
    <view class="section-card card" wx:if="{{species.precautions}}">
      <view class="card-title">注意事项</view>
      <view class="precautions-content">{{species.precautions}}</view>
    </view>

    <!-- 图集 -->
    <view class="section-card card" wx:if="{{species.images && species.images.length > 0}}">
      <view class="card-title">图集</view>
      <view class="image-gallery">
        <image
          class="gallery-image"
          wx:for="{{species.images}}"
          wx:key="index"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="previewImage"
        ></image>
      </view>
    </view>

    <!-- 标签 -->
    <view class="tags-card card" wx:if="{{species.tags && species.tags.length > 0}}">
      <view class="card-title">标签</view>
      <view class="tag-list">
        <text class="tag" wx:for="{{species.tags}}" wx:key="index">{{item}}</text>
      </view>
    </view>
  </view>
</view>