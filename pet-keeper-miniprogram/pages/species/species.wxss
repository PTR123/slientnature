/* pages/species/species.wxss */
.container {
  padding: 20rpx;
  background-color: #fefdfb;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 50rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
  padding: 0 8rpx;
}

.search-btn {
  background-color: #4a784a;
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 50rpx;
  border: none;
  height: 72rpx;
  line-height: 48rpx;
}

/* 分类滚动 */
.category-scroll {
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.category-item.active {
  background-color: #4a784a;
}

.category-item.active .category-icon,
.category-item.active .category-name {
  color: #fff;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 物种列表 */
.species-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.species-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
}

.species-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.species-info {
  flex: 1;
  min-width: 0;
}

.species-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.species-scientific {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
  margin-bottom: 8rpx;
}

.species-category {
  margin-bottom: 8rpx;
}

.species-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.species-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
}