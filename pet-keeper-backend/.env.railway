# Railway环境变量配置
# 在Railway Dashboard > Variables中添加

# 数据库和Redis（Railway自动注入）
# DATABASE_URL=postgresql://... (自动)
# REDIS_URL=redis://... (自动)

# 应用配置
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
NODE_ENV=production
PORT=3001

# CORS配置（部署后更新为Vercel前端URL）
CORS_ORIGIN=https://your-app.vercel.app

# 微信配置（可选）
WECHAT_APPID=wx_placeholder
WECHAT_SECRET=placeholder
WECHAT_MCH_ID=placeholder
WECHAT_PAY_KEY=placeholder

# OSS配置（可选）
OSS_ACCESS_KEY_ID=placeholder
OSS_ACCESS_KEY_SECRET=placeholder
OSS_BUCKET=placeholder
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com